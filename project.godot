; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Tower Defense Game Template"
run/main_scene="res://Scenes/ui/mainMenu/mainMenu.tscn"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PersistentQAgent="*res://MyAIProject/PersistentQAgent.cs"
Globals="*res://Scenes/main/Globals.gd"
Data="*res://Scenes/main/Data.gd"
GameLoggerSingleton="*res://MyAIProject/GameLoggerSingleton.cs"

[display]

window/size/viewport_width=850
window/size/viewport_height=1000
window/stretch/mode="viewport"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Tower Defense Game Template"

[input]

LeftClick={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":1,"position":Vector2(642, 33),"global_position":Vector2(650, 113),"factor":1.0,"button_index":1,"canceled":false,"pressed":true,"double_click":false,"script":null)
]
}

[physics]

common/physics_ticks_per_second=600
common/max_physics_steps_per_frame=80
